{
  "name": "cypress-automation",
  "version": "1.0.0",
  "description": "Automatización de pruebas con Cypress y TypeScript",
  "scripts": {
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:headless": "cypress run --browser chrome --headless",
    "cypress:run:api": "cypress run --spec 'cypress/e2e/api/**/*.cy.ts'",
    "report:merge": "mochawesome-merge 'cypress/reports/*.json' > cypress/reports/merged-report.json",
    "report:html": "marge cypress/reports/merged-report.json --reportDir cypress/reports/html --overwrite",
    "report:generate": "npm run cypress:run:api && npm run report:merge && npm run report:html"
  },
  "devDependencies": {
    "cypress": "^13.0.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "typescript": "^5.3.0",
    "@types/node": "^20.0.0"
  }
}
}
